<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@estilos.css" styleClass="fondo-catalogo" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fashionstylefx.GestionUsuariosController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <!-- Título -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E88E5;" text="Gestión de Usuarios" />
                
                <!-- Formulario -->
                <HBox spacing="20.0">
                    <children>
                        <TextField fx:id="txtNombre" promptText="Nombre" prefWidth="200" />
                        <TextField fx:id="txtCorreo" promptText="Correo" prefWidth="200" />
                        <TextField fx:id="txtTelefono" promptText="Teléfono" prefWidth="150" />
                        <TextField fx:id="txtRol" promptText="Rol (Cliente/Admin)" prefWidth="150" />
                        <Button fx:id="btnAgregar" text="Agregar" styleClass="boton-primario" />
                        <Button fx:id="btnActualizar" text="Actualizar" styleClass="boton-primario" />
                        <Button fx:id="btnLimpiar" text="Limpiar" />
                    </children>
                </HBox>
                
                <!-- Tabla de usuarios -->
                <TableView fx:id="tablaUsuarios" prefHeight="500.0">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="200" text="Nombre" />
                        <TableColumn fx:id="colCorreo" prefWidth="250" text="Correo" />
                        <TableColumn fx:id="colTelefono" prefWidth="150" text="Teléfono" />
                        <TableColumn fx:id="colRol" prefWidth="100" text="Rol" />
                        <TableColumn fx:id="colAcciones" prefWidth="150" text="Acciones" />
                    </columns>
                </TableView>
                
                <Button fx:id="btnVolver" text="← Volver" styleClass="boton-enlace" />
                <Label fx:id="lblMensaje" style="-fx-text-fill: red;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>