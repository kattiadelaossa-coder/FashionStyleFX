<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fashionstylefx.EditarPerfilController">
    <children>
        <VBox spacing="15.0" alignment="CENTER" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E88E5;" text="Editar Perfil" />
                
                <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Nombre" />
                <TextField fx:id="txtNombre" prefWidth="300.0" />
                
                <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Teléfono" />
                <TextField fx:id="txtTelefono" prefWidth="300.0" />
                
                <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Nueva Contraseña" />
                <PasswordField fx:id="txtPassword" prefWidth="300.0" />
                
                <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Confirmar Contraseña" />
                <PasswordField fx:id="txtConfirmPassword" prefWidth="300.0" />
                
                <Button fx:id="btnGuardar" text="GUARDAR CAMBIOS" styleClass="boton-primario" prefWidth="300.0" />
                <Button fx:id="btnCancelar" text="Cancelar" style="-fx-background-color: transparent; -fx-border-color: #999; -fx-border-radius: 8; -fx-text-fill: #666;" prefWidth="300.0" />
                
                <Label fx:id="lblMensaje" style="-fx-text-fill: red;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
