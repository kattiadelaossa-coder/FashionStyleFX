<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@estilos.css" styleClass="fondo-catalogo" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fashionstylefx.GestionPedidosController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <!-- Título -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E88E5;" text="Gestión de Pedidos" />
                
                <!-- Filtros -->
                <HBox spacing="20.0">
                    <children>
                        <ComboBox fx:id="cbFiltroEstado" promptText="Filtrar por estado" prefWidth="150" />
                        <Button fx:id="btnFiltrar" text="Filtrar" styleClass="boton-primario" />
                        <Button fx:id="btnLimpiarFiltro" text="Limpiar filtro" />
                    </children>
                </HBox>
                
                <!-- Tabla de pedidos -->
                <TableView fx:id="tablaPedidos" prefHeight="500.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colCliente" prefWidth="200" text="Cliente" />
                        <TableColumn fx:id="colFecha" prefWidth="150" text="Fecha" />
                        <TableColumn fx:id="colTotal" prefWidth="120" text="Total" />
                        <TableColumn fx:id="colEstado" prefWidth="150" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="200" text="Acciones" />
                    </columns>
                </TableView>
                
                <Button fx:id="btnVolver" text="← Volver" styleClass="boton-enlace" />
                <Label fx:id="lblMensaje" style="-fx-text-fill: red;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>